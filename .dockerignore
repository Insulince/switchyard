# Docs assets are build inputs to nothing -- keep them out of the image.
docs/

# Tests are not a build input. The Dockerfile copies *.go, which would
# otherwise sweep every _test.go file into the build layer -- `go build`
# ignores them, so they are pure weight.
*_test.go

